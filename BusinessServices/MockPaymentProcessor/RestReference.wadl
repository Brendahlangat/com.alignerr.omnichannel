<?xml version="1.0" encoding="UTF-8"?>
<application xmlns="http://wadl.dev.java.net/2009/02"
             xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:processor="http://example.local/omnichannel/processor">
    <grammars>
        <include href="../XSD/PaymentProcessorContract.xsd"/>
    </grammars>
    <resources base="http://localhost:9001/mock-payment-processor">
        <resource path="payments">
            <method name="POST" id="processPayment">
                <request>
                    <representation mediaType="application/xml"
                                    element="processor:ProcessorPaymentRequest"/>
                </request>
                <response status="200">
                    <representation mediaType="application/xml"
                                    element="processor:ProcessorPaymentResponse"/>
                </response>
                <response status="400">
                    <representation mediaType="application/xml"
                                    element="processor:ProcessorPaymentResponse"/>
                </response>
            </method>
        </resource>
    </resources>
</application>
