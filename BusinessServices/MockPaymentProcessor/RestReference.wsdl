<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:http="http://schemas.xmlsoap.org/wsdl/http/"
    xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/"
    xmlns:tns="http://example.local/omnichannel/processor/service"
    xmlns:processor="http://example.local/omnichannel/processor"
    targetNamespace="http://example.local/omnichannel/processor/service">
    <wsdl:types>
        <xs:schema targetNamespace="http://example.local/omnichannel/processor/service">
            <xs:import namespace="http://example.local/omnichannel/processor"
                       schemaLocation="../XSD/PaymentProcessorContract.xsd"/>
        </xs:schema>
    </wsdl:types>
    <wsdl:message name="ProcessorPaymentRequestMessage">
        <wsdl:part name="parameters" element="processor:ProcessorPaymentRequest"/>
    </wsdl:message>
    <wsdl:message name="ProcessorPaymentResponseMessage">
        <wsdl:part name="parameters" element="processor:ProcessorPaymentResponse"/>
    </wsdl:message>
    <wsdl:portType name="MockPaymentProcessorPortType">
        <wsdl:operation name="processPayment">
            <wsdl:input message="tns:ProcessorPaymentRequestMessage"/>
            <wsdl:output message="tns:ProcessorPaymentResponseMessage"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="MockPaymentProcessorHttpBinding" type="tns:MockPaymentProcessorPortType">
        <http:binding verb="POST"/>
        <wsdl:operation name="processPayment">
            <http:operation location="/payments"/>
            <wsdl:input>
                <mime:content type="application/xml" part="parameters"/>
            </wsdl:input>
            <wsdl:output>
                <mime:content type="application/xml" part="parameters"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="MockPaymentProcessorService">
        <wsdl:port name="MockPaymentProcessorPort" binding="tns:MockPaymentProcessorHttpBinding">
            <http:address location="http://localhost:9001/mock-payment-processor"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
