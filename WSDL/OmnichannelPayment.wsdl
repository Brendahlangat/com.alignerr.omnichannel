<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://brenda.example.com/omnichannel/payment/service"
    xmlns:pay="http://brenda.example.com/omnichannel/payment"
    targetNamespace="http://brenda.example.com/omnichannel/payment/service">
    <wsdl:types>
        <xs:schema targetNamespace="http://brenda.example.com/omnichannel/payment/service">
            <xs:import
                namespace="http://brenda.example.com/omnichannel/payment"
                schemaLocation="../BusinessServices/MockPaymentProcessor/OmnichannelPayment.xsd"/>
        </xs:schema>
    </wsdl:types>
    <wsdl:message name="PaymentRequestMessage">
        <wsdl:part name="parameters" element="pay:PaymentRequest"/>
    </wsdl:message>
    <wsdl:message name="PaymentResponseMessage">
        <wsdl:part name="parameters" element="pay:PaymentResponse"/>
    </wsdl:message>
    <wsdl:portType name="OmnichannelPaymentPortType">
        <wsdl:operation name="processPayment">
            <wsdl:input message="tns:PaymentRequestMessage"/>
            <wsdl:output message="tns:PaymentResponseMessage"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="OmnichannelPaymentSoapBinding" type="tns:OmnichannelPaymentPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="processPayment">
            <soap:operation soapAction="processPayment"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="OmnichannelPaymentService">
        <wsdl:port name="OmnichannelPaymentPort" binding="tns:OmnichannelPaymentSoapBinding">
            <soap:address location="http://localhost:7001/OmnichannelPaymentGateway"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
